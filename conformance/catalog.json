{
  "$schema": "./catalog-schema.json",
  "schema": "durable-workflow.conformance.catalog/v1",
  "stable_release": "2.0.0",
  "artifact_components": [
    "workflow",
    "waterline",
    "server",
    "cli",
    "sdk-php",
    "sdk-python",
    "sdk-rust"
  ],
  "evidence_policy": {
    "artifact_tuple_binding": "exact",
    "missing": "deny-stable",
    "stale": "deny-stable",
    "runner_blocked": "deny-stable",
    "ledger": "https://github.com/durable-workflow/.github/issues?q=is%3Aissue+label%3Akind%3Aconformance-run"
  },
  "experiments": [
    {
      "id": "activities",
      "title": "Activity execution and failure semantics",
      "tier": "release-critical",
      "owner_repository": "durable-workflow/server",
      "timeout_minutes": 90,
      "runners": [
        {
          "id": "published-artifacts",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/activities-published-artifacts.sh --result-dir \"$RESULT_DIR\"",
          "result": "activities-result.json"
        }
      ],
      "acceptance": [
        "Published workers execute, retry, heartbeat, fail, and complete activities with portable results."
      ]
    },
    {
      "id": "child-workflows",
      "title": "Child workflow lifecycle",
      "tier": "release-critical",
      "owner_repository": "durable-workflow/server",
      "timeout_minutes": 90,
      "runners": [
        {
          "id": "published-artifacts",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/child-workflows-published-artifacts.sh --result-dir \"$RESULT_DIR\"",
          "result": "child-workflows-result.json"
        }
      ],
      "acceptance": [
        "Child start, completion, failure, cancellation, and replay survive process replacement."
      ]
    },
    {
      "id": "cloud",
      "title": "Managed Cloud runtime",
      "tier": "release-critical",
      "owner_repository": "durable-workflow/cloud",
      "timeout_minutes": 90,
      "runners": [
        {
          "id": "isolated-namespace",
          "repository": "durable-workflow/cloud",
          "execution": "private-github-actions",
          "command": "gh workflow run conformance.yml --repo durable-workflow/cloud -f artifact_tuple_json=\"$ARTIFACT_TUPLE_JSON\"",
          "result": "cloud-conformance-result.json"
        }
      ],
      "acceptance": [
        "PHP, Python, and Rust clients and workers complete in an isolated Cloud conformance namespace without customer interference."
      ]
    },
    {
      "id": "heartbeats",
      "title": "Worker and activity heartbeat behavior",
      "tier": "release-critical",
      "owner_repository": "durable-workflow/server",
      "timeout_minutes": 90,
      "runners": [
        {
          "id": "php",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/heartbeats-published-artifacts.sh --result-dir \"$RESULT_DIR/php\"",
          "result": "php-sdk-heartbeat-loop-evidence.json"
        },
        {
          "id": "python",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/heartbeats-python-published-artifacts.sh --result-dir \"$RESULT_DIR/python\"",
          "result": "python-sdk-heartbeat-loop-evidence.json"
        },
        {
          "id": "rust",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/heartbeats-rust-published-artifacts.sh --result-dir \"$RESULT_DIR/rust\"",
          "result": "rust-sdk-heartbeat-loop-evidence.json"
        }
      ],
      "acceptance": [
        "All SDK workers advertise current heartbeats, become stale after loss, and expose accurate operator state."
      ]
    },
    {
      "id": "migration",
      "title": "Upgrade and migration continuity",
      "tier": "release-critical",
      "owner_repository": "durable-workflow/server",
      "timeout_minutes": 120,
      "runners": [
        {
          "id": "published-artifacts",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/migration-published-artifacts.sh --result-dir \"$RESULT_DIR\"",
          "result": "migration-conformance-result.json"
        }
      ],
      "acceptance": [
        "Supported upgrade paths preserve durable state and resume work after fresh process and database-model reloads."
      ]
    },
    {
      "id": "namespaces",
      "title": "Namespace isolation",
      "tier": "release-critical",
      "owner_repository": "durable-workflow/server",
      "timeout_minutes": 90,
      "runners": [
        {
          "id": "published-artifacts",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/namespaces-published-artifacts.sh --result-dir \"$RESULT_DIR\"",
          "result": "namespaces-result.json"
        }
      ],
      "acceptance": [
        "Workflow state, credentials, task queues, and operator views remain isolated by namespace."
      ]
    },
    {
      "id": "polyglot",
      "title": "PHP, Python, and Rust interoperability",
      "tier": "release-critical",
      "owner_repository": "durable-workflow/server",
      "timeout_minutes": 120,
      "runners": [
        {
          "id": "directional-matrix",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/activities-published-artifacts.sh --result-dir \"$RESULT_DIR/activities\"",
          "result": "activities-result.json"
        },
        {
          "id": "php-sdk",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/php-sdk-published-artifacts.sh --result-dir \"$RESULT_DIR/php\"",
          "result": "php-sdk-conformance-result.json"
        },
        {
          "id": "python-sdk",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/python-published-artifacts.sh --result-dir \"$RESULT_DIR/python\"",
          "result": "python-conformance-result.json"
        }
      ],
      "acceptance": [
        "Every first-party SDK appears as workflow author, activity worker, and client against the same portable protocol."
      ]
    },
    {
      "id": "replay",
      "title": "Deterministic cold replay",
      "tier": "release-critical",
      "owner_repository": "durable-workflow/server",
      "timeout_minutes": 120,
      "runners": [
        {
          "id": "published-artifacts",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/replay-published-artifacts.sh --result-dir \"$RESULT_DIR\"",
          "result": "replay-conformance-result.json"
        }
      ],
      "acceptance": [
        "Cold replay preserves portable value identity and rejects nondeterministic command history."
      ]
    },
    {
      "id": "schedules",
      "title": "Schedule lifecycle",
      "tier": "release-critical",
      "owner_repository": "durable-workflow/server",
      "timeout_minutes": 90,
      "runners": [
        {
          "id": "published-artifacts",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/schedules-published-artifacts.sh --result-dir \"$RESULT_DIR\"",
          "result": "schedules-runtime-result.json"
        }
      ],
      "acceptance": [
        "Create, pause, resume, trigger, and delete schedule operations remain durable across runtime restart."
      ]
    },
    {
      "id": "sdk-matrix",
      "title": "First-party SDK client and worker surface",
      "tier": "release-critical",
      "owner_repository": "durable-workflow/server",
      "timeout_minutes": 120,
      "runners": [
        {
          "id": "php",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/php-sdk-published-artifacts.sh --result-dir \"$RESULT_DIR/php\"",
          "result": "php-sdk-conformance-result.json"
        },
        {
          "id": "python",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/python-published-artifacts.sh --result-dir \"$RESULT_DIR/python\"",
          "result": "python-conformance-result.json"
        },
        {
          "id": "rust",
          "repository": "durable-workflow/sample-app",
          "execution": "local-docker",
          "command": "scripts/playground rust",
          "result": "storage/app/playground-rust-evidence.json"
        }
      ],
      "acceptance": [
        "Published PHP, Python, and Rust SDKs each start a workflow, operate a worker, execute an activity, and return a result."
      ]
    },
    {
      "id": "search-attributes",
      "title": "Search attribute portability and visibility",
      "tier": "release-critical",
      "owner_repository": "durable-workflow/server",
      "timeout_minutes": 90,
      "runners": [
        {
          "id": "published-artifacts",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/search-attributes-published-artifacts.sh --result-dir \"$RESULT_DIR\"",
          "result": "search-attributes-result.json"
        }
      ],
      "acceptance": [
        "Portable search attributes survive replay and remain queryable and visible without type loss."
      ]
    },
    {
      "id": "signals-queries",
      "title": "Signals and queries across SDKs",
      "tier": "release-critical",
      "owner_repository": "durable-workflow/server",
      "timeout_minutes": 120,
      "runners": [
        {
          "id": "published-artifacts",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/signals-queries-published-artifacts.sh --result-dir \"$RESULT_DIR\"",
          "result": "signals-queries-result.json"
        }
      ],
      "acceptance": [
        "Ordered signals and read-only queries work across PHP, Python, and Rust before and after cold replay."
      ]
    },
    {
      "id": "timers",
      "title": "Durable timers",
      "tier": "release-critical",
      "owner_repository": "durable-workflow/server",
      "timeout_minutes": 90,
      "runners": [
        {
          "id": "published-artifacts",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/timers-published-artifacts.sh --result-dir \"$RESULT_DIR\"",
          "result": "timers-result.json"
        }
      ],
      "acceptance": [
        "Pending timers survive worker and server replacement and fire once at or after their durable deadline."
      ]
    },
    {
      "id": "worker-versioning",
      "title": "Worker capability and version routing",
      "tier": "release-critical",
      "owner_repository": "durable-workflow/server",
      "timeout_minutes": 120,
      "runners": [
        {
          "id": "published-artifacts",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/worker-versioning-published-artifacts.sh --result-dir \"$RESULT_DIR\"",
          "result": "worker-versioning-result.json"
        }
      ],
      "acceptance": [
        "Tasks route only to compatible workers and rolling worker replacement preserves progress."
      ]
    },
    {
      "id": "workflow-lifecycle",
      "title": "Workflow lifecycle commands",
      "tier": "release-critical",
      "owner_repository": "durable-workflow/server",
      "timeout_minutes": 120,
      "runners": [
        {
          "id": "published-artifacts",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/workflow-lifecycle-published-artifacts.sh --result-dir \"$RESULT_DIR\"",
          "result": "workflow-lifecycle-result.json"
        }
      ],
      "acceptance": [
        "Start, result, cancel, terminate, continue-as-new, and failure behavior agree across first-party clients."
      ]
    },
    {
      "id": "workflow-updates",
      "title": "Workflow update lifecycle",
      "tier": "release-critical",
      "owner_repository": "durable-workflow/server",
      "timeout_minutes": 120,
      "runners": [
        {
          "id": "published-artifacts",
          "repository": "durable-workflow/server",
          "execution": "local-docker",
          "command": "bash scripts/conformance/workflow-updates-published-artifacts.sh --result-dir \"$RESULT_DIR\"",
          "result": "workflow-updates-result.json"
        }
      ],
      "acceptance": [
        "Update validation, acceptance, execution, deduplication, failure, and replay are durable across SDKs."
      ]
    }
  ]
}
