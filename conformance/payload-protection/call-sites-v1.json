    "inline_envelope": "JSON object {codec:\"avro\",blob:<canonical base64 text of one complete Avro single-object Value>}",
    "bare_inline_value": "canonical base64 text of one complete Avro single-object Value without a surrounding envelope",
    "external_runtime_reference": "JSON object {codec:\"avro\",external_payload:{schema,codec,reference_id,size_bytes,sha256}} whose object body is the exact ASCII base64 blob text",
