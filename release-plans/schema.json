{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/durable-workflow/.github/blob/main/release-plans/schema.json",
  "title": "Durable Workflow release plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan",
    "channel",
    "foundation",
    "components",
    "beta_authorization"
  ],
  "properties": {
    "schema": {
      "const": "durable-workflow.release-plan/v2"
    },
    "plan": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,55}$"
    },
    "channel": {
      "enum": ["alpha", "beta"]
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit"],
      "properties": {
        "tag": {
          "const": "beta-candidate/beta-continuity-foundation"
        },
        "commit": {
          "const": "4995052410bd4301c5796ffba54e0b6d2f490ed1"
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "waterline",
        "server",
        "cli",
        "sdk-php",
        "sdk-python",
        "sdk-rust"
      ],
      "properties": {
        "workflow": { "$ref": "#/$defs/component" },
        "waterline": { "$ref": "#/$defs/component" },
        "server": { "$ref": "#/$defs/component" },
        "cli": { "$ref": "#/$defs/component" },
        "sdk-php": { "$ref": "#/$defs/component" },
        "sdk-python": { "$ref": "#/$defs/component" },
        "sdk-rust": { "$ref": "#/$defs/component" }
      }
    },
    "beta_authorization": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "commit"],
          "properties": {
            "tag": {
              "type": "string",
              "pattern": "^beta-authorization/[a-z0-9][a-z0-9._-]{0,55}$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
