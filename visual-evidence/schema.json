{
  "$id": "https://github.com/durable-workflow/.github/blob/main/visual-evidence/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "customer_facing_extensions": {
      "items": {
        "pattern": "^\\.[a-z0-9.]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "interactions": {
      "additionalProperties": false,
      "properties": {
        "navigation": {
          "$ref": "#/$defs/interaction"
        },
        "search": {
          "$ref": "#/$defs/interaction"
        }
      },
      "required": [
        "navigation",
        "search"
      ],
      "type": "object"
    },
    "report_requirements": {
      "additionalProperties": false,
      "properties": {
        "empty_geometry_findings": {
          "contains": {
            "const": "unreachable_controls"
          },
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "empty_report_findings": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "false_geometry_flags": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "empty_geometry_findings",
        "empty_report_findings",
        "false_geometry_flags"
      ],
      "type": "object"
    },
    "review_contract": {
      "additionalProperties": false,
      "properties": {
        "audit": {
          "$ref": "#/$defs/reviewer"
        },
        "merge_gate": {
          "$ref": "#/$defs/reviewer"
        }
      },
      "required": [
        "audit",
        "merge_gate"
      ],
      "type": "object"
    },
    "schema": {
      "const": "durable-workflow.visual-evidence-policy/v1"
    },
    "visual_profiles": {
      "additionalProperties": false,
      "properties": {
        "rust-sdk-reference": {
          "$ref": "#/$defs/visualProfile"
        }
      },
      "required": [
        "rust-sdk-reference"
      ],
      "type": "object"
    },
    "viewport_classes": {
      "additionalProperties": false,
      "properties": {
        "desktop": {
          "$ref": "#/$defs/viewportClass"
        },
        "intermediate": {
          "$ref": "#/$defs/viewportClass"
        },
        "mobile": {
          "$ref": "#/$defs/viewportClass"
        }
      },
      "required": [
        "desktop",
        "intermediate",
        "mobile"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "customer_facing_extensions",
    "interactions",
    "report_requirements",
    "review_contract",
    "visual_profiles",
    "viewport_classes"
  ],
  "type": "object",
  "$defs": {
    "interaction": {
      "additionalProperties": false,
      "properties": {
        "content_patterns": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "interaction_selector_patterns": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "required_state": {
          "pattern": "^[a-z][a-z0-9-]*-open$",
          "type": "string"
        }
      },
      "required": [
        "content_patterns",
        "interaction_selector_patterns",
        "required_state"
      ],
      "type": "object"
    },
    "reviewer": {
      "additionalProperties": false,
      "properties": {
        "correlate_with_screenshot": {
          "const": true
        },
        "inspect_report_fields": {
          "contains": {
            "const": "geometry.unreachable_controls"
          },
          "items": {
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)?$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "correlate_with_screenshot",
        "inspect_report_fields"
      ],
      "type": "object"
    },
    "visualChangeRule": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "path_patterns": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "required_states": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "classification",
        "path_patterns",
        "required_states"
      ],
      "type": "object"
    },
    "visualProfile": {
      "additionalProperties": false,
      "properties": {
        "change_rules": {
          "items": {
            "$ref": "#/$defs/visualChangeRule"
          },
          "minItems": 1,
          "type": "array"
        },
        "repository": {
          "pattern": "^durable-workflow/[a-z0-9.-]+$",
          "type": "string"
        },
        "states": {
          "additionalProperties": {
            "$ref": "#/$defs/visualState"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "type": "object"
        },
        "surface": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "viewports": {
          "additionalProperties": false,
          "properties": {
            "desktop": {
              "$ref": "#/$defs/exactViewport"
            },
            "intermediate": {
              "$ref": "#/$defs/exactViewport"
            },
            "mobile": {
              "$ref": "#/$defs/exactViewport"
            }
          },
          "required": [
            "desktop",
            "intermediate",
            "mobile"
          ],
          "type": "object"
        }
      },
      "required": [
        "change_rules",
        "repository",
        "states",
        "surface",
        "viewports"
      ],
      "type": "object"
    },
    "visualState": {
      "additionalProperties": false,
      "properties": {
        "interaction_selector_patterns": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "required_page_hostname": {
          "format": "hostname",
          "type": "string"
        },
        "required_suppressed_requests": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "method": {
                "const": "GET"
              },
              "resource_type": {
                "const": "script"
              },
              "url": {
                "format": "uri",
                "pattern": "^https://",
                "type": "string"
              }
            },
            "required": [
              "method",
              "resource_type",
              "url"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "interaction_selector_patterns"
      ],
      "type": "object"
    },
    "exactViewport": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "maximum": 2400,
          "minimum": 480,
          "type": "integer"
        },
        "width": {
          "maximum": 2560,
          "minimum": 320,
          "type": "integer"
        }
      },
      "required": [
        "height",
        "width"
      ],
      "type": "object"
    },
    "viewportClass": {
      "additionalProperties": false,
      "properties": {
        "maximum_width": {
          "maximum": 2560,
          "minimum": 320,
          "type": "integer"
        },
        "minimum_width": {
          "maximum": 2560,
          "minimum": 320,
          "type": "integer"
        }
      },
      "required": [
        "minimum_width"
      ],
      "type": "object"
    }
  }
}
