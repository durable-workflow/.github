{
  "$schema": "./schema.json",
  "customer_facing_extensions": [
    ".blade.php",
    ".css",
    ".htm",
    ".html",
    ".jinja",
    ".jinja2",
    ".js",
    ".jsx",
    ".less",
    ".sass",
    ".scss",
    ".svelte",
    ".tsx",
    ".twig",
    ".vue"
  ],
  "interactions": {
    "navigation": {
      "content_patterns": [
        "(?i)(?:md-nav|__drawer|navigation|nav-(?:drawer|menu|toggle)|data-md-(?:component|toggle)=[\\\"']?(?:navigation|drawer))"
      ],
      "interaction_selector_patterns": [
        "(?i)(?:nav|navigation|drawer|menu)"
      ],
      "required_state": "navigation-open"
    },
    "search": {
      "content_patterns": [
        "(?i)(?:md-search|__search|search-(?:dialog|overlay|input|result)|data-md-(?:component|toggle)=[\\\"']?search)"
      ],
      "interaction_selector_patterns": [
        "(?i)search"
      ],
      "required_state": "search-open"
    }
  },
  "report_requirements": {
    "empty_geometry_findings": [
      "clipped_text",
      "clipped_control_text",
      "oversized_choice_controls",
      "unreachable_controls"
    ],
    "empty_report_findings": [
      "console_errors",
      "http_errors",
      "request_failures",
      "page_errors"
    ],
    "false_geometry_flags": [
      "horizontal_overflow"
    ]
  },
  "review_contract": {
    "audit": {
      "correlate_with_screenshot": true,
      "inspect_report_fields": [
        "geometry.clipped_text",
        "geometry.clipped_control_text",
        "geometry.horizontal_overflow",
        "geometry.oversized_choice_controls",
        "geometry.unreachable_controls",
        "console_errors",
        "http_errors",
        "request_failures",
        "page_errors"
      ]
    },
    "merge_gate": {
      "correlate_with_screenshot": true,
      "inspect_report_fields": [
        "geometry.clipped_text",
        "geometry.clipped_control_text",
        "geometry.horizontal_overflow",
        "geometry.oversized_choice_controls",
        "geometry.unreachable_controls",
        "console_errors",
        "http_errors",
        "request_failures",
        "page_errors"
      ]
    }
  },
  "schema": "durable-workflow.visual-evidence-policy/v1",
  "visual_profiles": {
    "rust-sdk-reference": {
      "change_rules": [
        {
          "classification": "rust-sdk-reference",
          "path_patterns": [
            "^docs/(?:[^/]+\\.html|analytics/[^/]+\\.(?:css|js))$"
          ],
          "required_states": [
            "initial"
          ]
        },
        {
          "classification": "rust-sdk-analytics",
          "path_patterns": [
            "^docs/(?:analytics-head\\.html|analytics/[^/]+\\.(?:css|js))$"
          ],
          "required_states": [
            "initial",
            "granted",
            "denied",
            "preferences-open"
          ]
        }
      ],
      "repository": "durable-workflow/sdk-rust",
      "states": {
        "denied": {
          "interaction_selector_patterns": [
            "data-consent[^]]*denied"
          ]
        },
        "granted": {
          "interaction_selector_patterns": [
            "data-consent[^]]*granted"
          ]
        },
        "initial": {
          "interaction_selector_patterns": []
        },
        "preferences-open": {
          "interaction_selector_patterns": [
            "analytics-preferences"
          ]
        }
      },
      "surface": "rust-sdk-reference",
      "viewports": {
        "desktop": {
          "height": 900,
          "width": 1440
        },
        "intermediate": {
          "height": 900,
          "width": 800
        },
        "mobile": {
          "height": 844,
          "width": 390
        }
      }
    }
  },
  "viewport_classes": {
    "desktop": {
      "minimum_width": 960
    },
    "intermediate": {
      "maximum_width": 959,
      "minimum_width": 641
    },
    "mobile": {
      "maximum_width": 640,
      "minimum_width": 320
    }
  }
}
