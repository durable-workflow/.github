{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/durable-workflow/.github/main/regression-corpus/evidence-schema.json",
  "title": "Durable Workflow regression evidence",
  "oneOf": [
    {
      "$ref": "#/$defs/codec"
    },
    {
      "$ref": "#/$defs/replay"
    }
  ],
  "$defs": {
    "bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "php",
          "python",
          "rust"
        ]
      }
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "codec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "fixture_schema",
        "id",
        "protocol",
        "bindings",
        "value",
        "framing",
        "failure_policy"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "format": "uri-reference"
        },
        "fixture_schema": {
          "const": "durable-workflow.codec-regression/v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codec",
            "schema",
            "version",
            "fingerprint"
          ],
          "properties": {
            "codec": {
              "type": "string",
              "minLength": 1
            },
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "fingerprint": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "bindings": {
          "$ref": "#/$defs/bindings"
        },
        "value": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "framing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "wire_base64"
          ],
          "properties": {
            "encoding": {
              "type": "string",
              "minLength": 1
            },
            "wire_base64": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "failure_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "error"
          ],
          "properties": {
            "operation": {
              "enum": [
                "round_trip",
                "decode_reject",
                "encode_reject"
              ]
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "supersedes": {
          "$ref": "#/$defs/supersedes"
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "fixture_schema",
        "id",
        "protocol_version",
        "bindings",
        "workflow",
        "expected"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "format": "uri-reference"
        },
        "fixture_schema": {
          "const": "durable-workflow.replay-regression/v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "bindings": {
          "$ref": "#/$defs/bindings"
        },
        "workflow": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "history": {
          "type": "array",
          "minItems": 1
        },
        "command_sequence": {
          "type": "array",
          "minItems": 1
        },
        "expected": {
          "type": "object",
          "minProperties": 1
        },
        "supersedes": {
          "$ref": "#/$defs/supersedes"
        }
      },
      "anyOf": [
        {
          "required": [
            "history"
          ]
        },
        {
          "required": [
            "command_sequence"
          ]
        }
      ]
    }
  }
}
