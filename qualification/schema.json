{
  "$id": "https://github.com/durable-workflow/.github/blob/main/qualification/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "action_runtime": {
      "$ref": "#/$defs/actionRuntime"
    },
    "organization": {
      "const": "durable-workflow"
    },
    "required_status_checks_strict": {
      "const": true
    },
    "schema": {
      "const": "durable-workflow.github-target-qualification/v1"
    },
    "targets": {
      "additionalProperties": {
        "$ref": "#/$defs/target"
      },
      "minProperties": 12,
      "type": "object"
    },
    "workflow_trust": {
      "$ref": "#/$defs/workflowTrust"
    }
  },
  "required": [
    "schema",
    "action_runtime",
    "organization",
    "required_status_checks_strict",
    "workflow_trust",
    "targets"
  ],
  "type": "object",
  "$defs": {
    "actionRuntime": {
      "additionalProperties": false,
      "properties": {
        "allowed_container_images": {
          "additionalProperties": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "type": "object"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9._/-]+$"
          },
          "type": "object"
        },
        "allowed_releases": {
          "additionalProperties": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[0-9a-f]{40}$"
            },
            "type": "object"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$"
          },
          "type": "object"
        },
        "supported_javascript_runtimes": {
          "const": [
            "node24"
          ]
        }
      },
      "required": [
        "allowed_container_images",
        "allowed_releases",
        "supported_javascript_runtimes"
      ],
      "type": "object"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "const": "main"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "public_audit": {
          "type": "boolean"
        },
        "workflows": {
          "items": {
            "$ref": "#/$defs/workflow"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "repository",
        "branch",
        "workflows"
      ],
      "type": "object"
    },
    "validatorPrecedingStep": {
      "additionalProperties": false,
      "properties": {
        "uses": {
          "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+@[0-9a-f]{40}$",
          "type": "string"
        },
        "with": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "type": "object"
        }
      },
      "required": [
        "uses",
        "with"
      ],
      "type": "object"
    },
    "workflowRunConsumer": {
      "additionalProperties": false,
      "properties": {
        "artifact_digest_validator_command": {
          "minLength": 1,
          "type": "string"
        },
        "artifact_digest_validator_environment": {
          "items": {
            "enum": [
              "GITHUB_TOKEN",
              "GH_TOKEN",
              "REQUESTED_RUN_ATTEMPT",
              "REQUESTED_RUN_ID"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "artifact_digest_validator_preceding_steps": {
          "items": {
            "$ref": "#/$defs/validatorPrecedingStep"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array"
        },
        "event": {
          "enum": [
            "push",
            "workflow_dispatch"
          ]
        },
        "identity_validator_command": {
          "minLength": 1,
          "type": "string"
        },
        "identity_validator_environment": {
          "items": {
            "enum": [
              "GITHUB_TOKEN",
              "GH_TOKEN",
              "REQUESTED_RUN_ATTEMPT",
              "REQUESTED_RUN_ID"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "identity_validator_preceding_steps": {
          "items": {
            "$ref": "#/$defs/validatorPrecedingStep"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array"
        },
        "privileged_job_condition": {
          "minLength": 1,
          "type": "string"
        },
        "protected_ref": {
          "minLength": 1,
          "type": "string"
        },
        "repository": {
          "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$",
          "type": "string"
        },
        "validator_runner": {
          "const": "ubuntu-latest"
        },
        "workflow": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "repository",
        "workflow",
        "event",
        "protected_ref",
        "identity_validator_command",
        "identity_validator_environment",
        "identity_validator_preceding_steps",
        "privileged_job_condition",
        "artifact_digest_validator_command",
        "artifact_digest_validator_environment",
        "artifact_digest_validator_preceding_steps",
        "validator_runner"
      ],
      "type": "object"
    },
    "workflowTrust": {
      "additionalProperties": false,
      "properties": {
        "privileged_artifact_handoffs": {
          "$ref": "#/$defs/artifactHandoff"
        },
        "privileged_workflow_run_consumers": {
          "additionalProperties": {
            "$ref": "#/$defs/workflowRunConsumer"
          },
          "type": "object"
        },
        "pull_request_target_exceptions": {
          "maxItems": 0,
          "type": "array"
        }
      },
      "required": [
        "privileged_artifact_handoffs",
        "privileged_workflow_run_consumers",
        "pull_request_target_exceptions"
      ],
      "type": "object"
    },
    "artifactHandoff": {
      "additionalProperties": false,
      "properties": {
        "validator_command": {
          "minLength": 1,
          "type": "string"
        },
        "validator_environment": {
          "const": [
            "ARTIFACT_DIRECTORY",
            "EXPECTED_ARTIFACT_DIGEST",
            "EXPECTED_ARTIFACT_ID",
            "EXPECTED_SOURCE_RUN_ATTEMPT",
            "EXPECTED_SOURCE_RUN_ID"
          ]
        },
        "validator_preceding_steps": {
          "items": {
            "$ref": "#/$defs/validatorPrecedingStep"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "validator_runner": {
          "const": "ubuntu-latest"
        }
      },
      "required": [
        "validator_command",
        "validator_environment",
        "validator_preceding_steps",
        "validator_runner"
      ],
      "type": "object"
    },
    "workflow": {
      "additionalProperties": false,
      "properties": {
        "action_policy_preflight": {
          "type": "boolean"
        },
        "matrix_independent": {
          "type": "boolean"
        },
        "path": {
          "pattern": "^[a-z0-9][a-z0-9.-]*\\.yml$",
          "type": "string"
        },
        "required_check": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path",
        "required_check",
        "matrix_independent"
      ],
      "type": "object"
    }
  }
}
