{
  "$id": "https://github.com/durable-workflow/.github/blob/main/qualification/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "organization": {
      "const": "durable-workflow"
    },
    "required_status_checks_strict": {
      "const": true
    },
    "schema": {
      "const": "durable-workflow.github-target-qualification/v1"
    },
    "targets": {
      "additionalProperties": {
        "$ref": "#/$defs/target"
      },
      "minProperties": 10,
      "type": "object"
    }
  },
  "required": [
    "schema",
    "organization",
    "required_status_checks_strict",
    "targets"
  ],
  "type": "object",
  "$defs": {
    "target": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "enum": [
            "main",
            "v2"
          ]
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "workflows": {
          "items": {
            "$ref": "#/$defs/workflow"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "repository",
        "branch",
        "workflows"
      ],
      "type": "object"
    },
    "workflow": {
      "additionalProperties": false,
      "properties": {
        "matrix_independent": {
          "type": "boolean"
        },
        "path": {
          "pattern": "^[a-z0-9][a-z0-9.-]*\\.yml$",
          "type": "string"
        },
        "required_check": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path",
        "required_check",
        "matrix_independent"
      ],
      "type": "object"
    }
  }
}
